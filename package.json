{
  "name": "verzel-store-qa",
  "version": "2.0.0",
  "private": true,
  "description": "Validação da entrega VZS-142: cupons e frete grátis com Playwright e TypeScript.",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium",
    "test:video": "playwright test --config=playwright.video.config.ts",
    "test:verification": "playwright test --config=playwright.verification.config.ts",
    "report:verification": "playwright show-report verification-report",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --project=chromium --ui",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "evidence": "node scripts/snapshot-evidence.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
